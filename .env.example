# Variables de entorno de FinZen
# Copia este archivo a .env y completa los valores.
# ⚠️ NUNCA subas .env al repo ni compartas las keys por chat.

# ── Base de datos (Turso) ─────────────────────────────────────────
# Obligatoria en producción: sin ella la app REHÚSA arrancar (fail-fast
# anti divergencia de datos — ver auditoría P0-1, 27-sep-2026).
# Formato: la URL de Turso con el token como query param, o usa
# TURSO_AUTH_TOKEN aparte (db.ts soporta ambos).
DATABASE_URL=libsql://TU-BASE-TU-USUARIO.turso.io?authToken=TU_TOKEN

# ── NextAuth ──────────────────────────────────────────────────────
# Genera uno nuevo: openssl rand -base64 32
# ⚠️ Si no se define, se usa el FALLBACK del código — configurarlo en
# Vercel y remover el fallback es deuda de seguridad pendiente.
NEXTAUTH_SECRET=

# Opcional: password del usuario seed de desarrollo (solo file-SQLite dev)
FINZEN_DEV_SEED_PASSWORD=

# Opcional: escape hatch explícito para servir con SQLite efímero en prod.
# NO usar salvo para demos desechables — es la causa del P0-1.
# FINZEN_ALLOW_EPHEMERAL_DB=1
